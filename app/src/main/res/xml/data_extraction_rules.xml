<?xml version="1.0" encoding="utf-8"?>
<!-- App data must travel only in owner-approved encrypted .njbak archives.
     Avoid transferring a device-bound SQLCipher database without its Keystore key. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
